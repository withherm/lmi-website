---
/**
 * Lean Methods Institute icon library. EQT-417.
 *
 * Grammar lifted from equibt-website/src/components/icons: single-weight
 * line art, round caps and joins, no fill, no container box, one accent
 * stroke per icon. Recoloured to the blue system: Deep Navy carries the
 * drawing, Cyan carries the one thing the icon is actually about.
 *
 * 64 viewBox, 3.2 stroke, which lands on the same optical weight as the
 * EQUIBT set at 375/21.83. Sized by the page wrapper (.ic), never here.
 * Stroke classes .hd and .hd-acc live in base.css so a colour change is
 * one edit, not twenty.
 *
 * Usage: <Icon name="lean-six-sigma" />
 */
interface Props { name: string; }
const { name } = Astro.props;

