---
const links = [
  { href: "/methods/", label: "Methods" },
  { href: "/certifications/", label: "Certifications" },
  { href: "/resources/", label: "Resources" },
  { href: "/insights/", label: "Insights" },
];
---
<nav class="site-nav" id="site-nav" aria-label="Primary">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Lean Methods Institute home">
      <img src="/assets/logos/lmi-logo.svg" alt="Lean Methods Institute" width="186" height="48" />
    </a>

    <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span><span></span>
    </button>

    <div class="nav-links" id="nav-links">
      <div class="nav-item" data-dropdown data-open="false">
        <div class="nav-item-row">
          <a href="/courses/" class="nav-link">Courses</a>
          <button class="nav-chevron-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Toggle Courses submenu">
            <span class="nav-chevron" aria-hidden="true">&#9662;</span>
          </button>
        </div>
        <ul class="nav-dropdown" role="menu">
          <li role="none"><a href="/courses/lean-six-sigma/" role="menuitem" class="nav-dropdown-item"><span class="nav-dropdown-eyebrow">AUSQ CERTIFIED</span><span class="nav-dropdown-label">Lean Six Sigma</span></a></li>
          <li role="none"><a href="/courses/lean-service-design/" role="menuitem" class="nav-dropdown-item"><span class="nav-dropdown-eyebrow">AUSQ CERTIFIED</span><span class="nav-dropdown-label">Lean Service Design</span></a></li>
          <li role="none"><a href="/courses/lean-business-analysis/" role="menuitem" class="nav-dropdown-item"><span class="nav-dropdown-eyebrow">AUSQ CERTIFIED</span><span class="nav-dropdown-label">Lean Business Analysis</span></a></li>
        </ul>
      </div>

      {links.map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}

      <div class="nav-item" data-dropdown data-open="false">
        <div class="nav-item-row">
          <a href="/about/" class="nav-link">About</a>
          <button class="nav-chevron-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Toggle About submenu">
            <span class="nav-chevron" aria-hidden="true">&#9662;</span>
          </button>
        </div>
        <ul class="nav-dropdown" role="menu">
          <li role="none"><a href="/approach/" role="menuitem" class="nav-dropdown-item"><span class="nav-dropdown-label">Approach</span></a></li>
          <li role="none"><a href="/about/" role="menuitem" class="nav-dropdown-item"><span class="nav-dropdown-label">For teams</span></a></li>
          <li role="none"><a href="/courses/" role="menuitem" class="nav-dropdown-item"><span class="nav-dropdown-label">For individuals</span></a></li>
        </ul>
      </div>

      <a href="/contact/" class="btn nav-cta">Get in touch</a>
    </div>
  </div>
</nav>
