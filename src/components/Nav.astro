<script>
  // Dropdown + mobile accordion logic (mirrors EQUIBT v6x foundation).
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  function openItem(item: HTMLElement) {
    const btn = item.querySelector<HTMLButtonElement>('.nav-chevron-btn');
    if (btn) btn.setAttribute('aria-expanded', 'true');
    item.classList.add('is-open');
  }

  function closeItem(item: HTMLElement) {
    const btn = item.querySelector<HTMLButtonElement>('.nav-chevron-btn');
    if (btn) btn.setAttribute('aria-expanded', 'false');
    item.classList.remove('is-open');
  }

  function isMobile() {
    return window.innerWidth <= 760;
  }

  dropdowns.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('.nav-chevron-btn');

    item.addEventListener('focusin', () => {
      if (!isMobile()) openItem(item);
    });
    item.addEventListener('focusout', (e: FocusEvent) => {
      if (!isMobile() && !item.contains(e.relatedTarget as Node)) closeItem(item);
    });

    btn?.addEventListener('click', (e) => {
      if (isMobile()) {
        e.preventDefault();
        if (item.classList.contains('is-open')) {
          closeItem(item);
        } else {
          openItem(item);
        }
      }
    });

    item.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeItem(item);
        btn?.focus();
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!isMobile()) {
      dropdowns.forEach((item) => {
        if (!item.contains(e.target as Node)) closeItem(item);
      });
    }
  });

  // Hamburger toggle
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const navLinks = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const open = navLinks?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.body.classList.toggle('nav-open', !!open);
  });

  if (navLinks) {
    const observer = new MutationObserver(() => {
      if (!navLinks.classList.contains('is-open')) {
        dropdowns.forEach(closeItem);
      }
    });
    observer.observe(navLinks, { attributes: true, attributeFilter: ['class'] });
  }
</script>
