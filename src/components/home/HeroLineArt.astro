---
import ABSwitch from "./ABSwitch.astro";
---

<section class="hero hero-line home-reveal">
  <ABSwitch current="a" />
  <div class="hero-inner">
    <div class="hero-copy">
      <div class="eyebrow">AI-integrated · independently assured</div>
      <h1>Build a Lean, AI-capable team.</h1>
      <p class="hero-subhead">Lean Methods Institute helps organisations build practical improvement capability through certified Lean, Lean Six Sigma and AI-enabled training.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn-primary">Get in touch</a>
        <a href="#programs" class="btn-text"><span class="link-label">Explore programs</span> <span class="ar">&rsaquo;</span></a>
      </div>
    </div>
    <div class="hero-art hero-art-line" aria-label="Interim line-art motif, final Affinity redraw pending">
      <svg viewBox="0 0 620 420" role="img" aria-labelledby="line-art-title">
        <title id="line-art-title">Connected team capability resolving into an AI-capable outcome</title>
        <path class="hd-f2" d="M70 295 C154 246 214 275 285 222 C361 164 420 180 536 90"/>
        <path class="hd" d="M80 294 C155 256 218 269 286 224 C356 178 418 177 534 92"/>
        <path class="hd-acc" d="M425 175 C465 146 500 119 534 92"/>
        <circle class="hero-node" cx="80" cy="294" r="16"/>
        <circle class="hero-node" cx="187" cy="254" r="13"/>
        <circle class="hero-node" cx="286" cy="224" r="15"/>
        <circle class="hero-node" cx="408" cy="180" r="13"/>
        <circle class="hero-node-acc" cx="534" cy="92" r="19"/>
        <path class="hd-f1" d="M80 294 L187 254 L286 224"/>
        <path class="hd-f1" d="M187 254 L408 180"/>
        <path class="hd-f1" d="M286 224 L408 180"/>
        <path class="hd-f3" d="M104 328 C185 363 312 357 384 314"/>
        <path class="hd-f3" d="M350 110 C394 77 455 62 508 69"/>
      </svg>
      <p>Interim line-art · Affinity redraw pending</p>
    </div>
  </div>
</section>
