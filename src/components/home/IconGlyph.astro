---
interface Props {
  name: "roadmap" | "automation" | "loop" | "network" | "capability" | "assure" | "government" | "financial";
}

const { name } = Astro.props;
---

{name === "roadmap" && (
  <svg viewBox="0 0 64 64" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path class="hd" stroke-width="2.8" d="M10 52 C22 52 20 32 32 32 C44 32 42 12 54 12"/><circle fill="var(--navy)" cx="10" cy="52" r="3"/><circle fill="var(--navy)" cx="32" cy="32" r="3"/><circle fill="var(--action)" cx="54" cy="12" r="3.6"/></svg>
)}

{name === "automation" && (
  <svg viewBox="0 0 64 64" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path class="hd" stroke-width="2.8" d="M44.35 33.96 L49.28 34.74 A17.5 17.5 0 0 0 49.28 29.26 L44.35 30.04 A12.5 12.5 0 0 0 42.11 24.65 L46.16 21.71 A17.5 17.5 0 0 0 42.29 17.84 L39.35 21.89 A12.5 12.5 0 0 0 33.96 19.65 L34.74 14.72 A17.5 17.5 0 0 0 29.26 14.72 L30.04 19.65 A12.5 12.5 0 0 0 24.65 21.89 L21.71 17.84 A17.5 17.5 0 0 0 17.84 21.71 L21.89 24.65 A12.5 12.5 0 0 0 19.65 30.04 L14.72 29.26 A17.5 17.5 0 0 0 14.72 34.74 L19.65 33.96 A12.5 12.5 0 0 0 21.89 39.35 L17.84 42.29 A17.5 17.5 0 0 0 21.71 46.16 L24.65 42.11 A12.5 12.5 0 0 0 30.04 44.35 L29.26 49.28 A17.5 17.5 0 0 0 34.74 49.28 L33.96 44.35 A12.5 12.5 0 0 0 39.35 42.11 L42.29 46.16 A17.5 17.5 0 0 0 46.16 42.29 L42.11 39.35 A12.5 12.5 0 0 0 44.35 33.96 Z"/><circle fill="var(--action)" cx="32" cy="32" r="3.6"/></svg>
)}

{name === "loop" && (
  <svg viewBox="0 0 64 64" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path class="hd" stroke-width="2.8" d="M14 26 A18 18 0 0 1 47 19"/><path class="hd" stroke-width="2.8" d="M47 10.5 V19 H38.5"/><path class="hd-acc" stroke-width="2.8" d="M50 38 A18 18 0 0 1 17 45"/><path class="hd-acc" stroke-width="2.8" d="M17 53.5 V45 H25.5"/></svg>
)}

{name === "network" && (
  <svg viewBox="0 0 64 64" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><circle class="hd" stroke-width="2.8" cx="16" cy="20" r="5.5"/><circle class="hd" stroke-width="2.8" cx="48" cy="16" r="5.5"/><circle fill="var(--action)" cx="36" cy="46" r="5.8"/><path class="hd" stroke-width="2.8" d="M19 25 L33 41"/><path class="hd" stroke-width="2.8" d="M45.5 21 L38.5 40.5"/><path class="hd" stroke-width="2.8" d="M21.5 19.3 L42.5 16.7"/></svg>
)}

{name === "capability" && (
  <svg viewBox="0 0 64 64" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><circle class="hd" stroke-width="2.8" cx="25" cy="19" r="8"/><path class="hd" stroke-width="2.8" d="M11 50 Q11 35 25 35 Q39 35 39 50"/><path class="hd-acc" stroke-width="2.8" d="M48 26 V38"/><path class="hd-acc" stroke-width="2.8" d="M42 32 H54"/></svg>
)}

{name === "assure" && (
  <svg viewBox="0 0 64 64" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path class="hd" stroke-width="2.8" d="M32 8 Q25 12 16 13 Q15.5 32 20 41 Q25 50 32 55 Q39 50 44 41 Q48.5 32 48 13 Q39 12 32 8 Z"/><path class="hd-acc" stroke-width="2.8" d="M25 31 L30 38 L40 24"/></svg>
)}

{name === "government" && (
  <svg viewBox="0 0 64 64" aria-hidden="true"><path class="hd" d="M14 49 Q32 52 50 49"/><path class="hd" d="M16 21 Q31 11 48 20"/><path class="hd" d="M20 25 Q18 36 21 45"/><path class="hd" d="M32 19 Q30 34 32 47"/><path class="hd-acc" d="M44 25 Q47 36 43 45"/><circle cx="32" cy="19" r="3.2" fill="var(--navy)"/></svg>
)}

{name === "financial" && (
  <svg viewBox="0 0 64 64" aria-hidden="true"><path class="hd" d="M11 50 Q32 51 53 49.6"/><path class="hd" d="M14 24 Q32 14 50 24"/><path class="hd" d="M19 26 Q18.6 38 19 47"/><path class="hd" d="M28 26 Q27.6 38 28 47"/><path class="hd-acc" d="M37 26 Q36.6 38 37 47"/><path class="hd" d="M46 26 Q45.6 38 46 47"/></svg>
)}
