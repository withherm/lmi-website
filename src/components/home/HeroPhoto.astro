---
import ABSwitch from "./ABSwitch.astro";
---

<section class="hero hero-photo home-reveal">
  <ABSwitch current="b" />
  <div class="hero-inner">
    <div class="hero-copy">
      <div class="eyebrow">AI-integrated · independently assured</div>
      <h1>Build a Lean, AI-capable team.</h1>
      <p class="hero-subhead">Lean Methods Institute helps organisations build practical improvement capability through certified Lean, Lean Six Sigma and AI-enabled training.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn-primary">Get in touch</a>
        <a href="#programs" class="btn-text"><span class="link-label">Explore programs</span> <span class="ar">&rsaquo;</span></a>
      </div>
    </div>
    <div class="photo-frame hero-photo-frame" role="img" aria-label="Photo slot, real LMI session">
      <div class="photo-placeholder">
        <span>Photo slot · real LMI session</span>
      </div>
      <div class="photo-overlay">
        <span>In-house · delivered on site</span>
        <strong>Trained on their own processes.</strong>
      </div>
    </div>
  </div>
</section>
