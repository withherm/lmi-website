---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Accessibility Statement | Lean Methods Institute" description="Lean Methods Institute accessibility statement.">
  <Nav />
  <main class="policy-main">
    <article class="policy-inner">
      <div class="eyebrow">POLICY</div>
      <h1>Accessibility Statement</h1>
      <p>This page is a placeholder for the Lean Methods Institute accessibility statement. Full accessibility copy will be added before public launch.</p>
      <h2>Access commitment</h2>
      <p>LMI aims to make its website and course information usable for a broad range of learners and organisational buyers.</p>
      <h2>Feedback</h2>
      <p>Accessibility feedback and support contact details will be confirmed before public launch.</p>
    </article>
  </main>
  <Footer />
</Layout>
