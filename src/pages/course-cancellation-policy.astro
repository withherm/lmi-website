---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Course Cancellation Policy | Lean Methods Institute" description="Lean Methods Institute course cancellation policy.">
  <Nav />
  <main class="policy-main">
    <article class="policy-inner">
      <div class="eyebrow">POLICY</div>
      <h1>Course Cancellation Policy</h1>
      <p>This page is a placeholder for the Lean Methods Institute course cancellation policy. Full policy copy will be added before public launch.</p>
      <h2>Course changes</h2>
      <p>If a scheduled course needs to change, LMI will contact registered participants using the details provided at enrolment.</p>
      <h2>Participant cancellations</h2>
      <p>Participant cancellation, transfer and refund rules will be published here when the final policy wording is approved.</p>
    </article>
  </main>
  <Footer />
</Layout>
