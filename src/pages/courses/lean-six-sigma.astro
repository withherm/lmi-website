---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BeltBadge from "../../components/BeltBadge.astro";
import Illus from "../../components/Illus.astro";
import "../../styles/home.css";

const outcomes = [
  "Frame a problem your leadership already cares about, and scope it so it can actually be finished.",
  "Measure what the process really does, rather than what the procedure says it does.",
  "Find the cause with a test you can defend, not the cause everyone already assumed.",
  "Design and pilot a change with the people who do the work.",
  "Hold the gain with controls that survive after you move on.",
  "Present the result in the language your finance team accepts.",
];

const modules = [
  { h: "Define",  b: "Problem framing, scope, the business case, and the sponsor conversation." },
  { h: "Measure", b: "Process mapping, data collection, measurement system analysis." },
  { h: "Analyse", b: "Root cause, hypothesis testing, and the tests worth running." },
  { h: "Improve", b: "Solution design, pilot, and the change your team will actually adopt." },
  { h: "Control", b: "Control plans, mistake proofing, and the handover that holds." },
];

const gates = [
  { h: "Training",      b: "Attend and take part in the full programme." },
  { h: "Knowledge test","b2": "A test of the method, not a memory test on jargon." },
  { h: "Application",   b: "A real project from your own workplace, documented." },
  { h: "Coaching",      b: "Reviews with an assessor through the project, not just at the end." },
];
---
<Layout title="Lean Six Sigma Green Belt | Lean Methods Institute" description="Lead a Lean Six Sigma project end to end and prove the result with data. Assessed on a real project from your workplace and certified by AUSQ.">
  <Nav />
  <main id="main">

    <section class="page-head">
      <div class="wrap grid-course-head">
        <div>
          <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px">
            <BeltBadge code="GB" size={54} selected={true} />
            <p class="eyebrow" style="margin:0">Lean Six Sigma &middot; Green Belt</p>
          </div>
          <h1>Lead a project end to end and prove the result.</h1>
          <p class="lede">Green Belt is where a practitioner stops assisting and starts running the work. You bring a live problem from your own workplace, and you leave with it closed out and the result documented.</p>
        </div>

        <aside class="enrol" aria-label="Enrolment">
          <div class="enrol-price">$<span class="todo">PRICE</span><small>Per participant, including GST</small></div>
          <ul class="enrol-rows">
            <li><span class="k">Next dates</span><span><span class="todo">NEXT DATES</span></span></li>
            <li><span class="k">Duration</span><span>5 days over 3 months</span></li>
            <li><span class="k">Format</span><span>In-house or public</span></li>
            <li><span class="k">Credential</span><span>AUSQ certified</span></li>
          </ul>
          <a class="btn" href="/contact/" style="width:100%">Enrol</a>
          <a class="chev" href="/contact/">Enquire about in-house <span class="c" aria-hidden="true">&rsaquo;</span></a>
        </aside>
      </div>
    </section>

    <section class="sec g-off reveal">
      <div class="wrap">
        <div class="measure" style="margin-bottom:30px">
          <p class="eyebrow">Outcomes</p>
          <h2>What you will be able to do.</h2>
        </div>
        <div class="grid g2">
          {outcomes.map((o) => (
            <div class="card"><p class="small" style="margin:0">{o}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec g-white reveal">
      <div class="wrap split">
        <div>
          <p class="eyebrow">AI in this course</p>
          <h2>Where AI carries the work, and where it must not.</h2>
          <p>AI runs the first pass on the data, drafts the process map from your notes, and suggests which tests are worth running. You choose the test, you own the assumption behind it, and you sign the control plan. A model cannot hold a control, and it cannot stand behind a capability claim in front of a regulator.</p>
          <p>You learn this on the tools you already have, not on a platform we sell you.</p>
        </div>
        <Illus label="Illustration: practitioner and colleague reviewing an analysis on screen" h="300px" />
      </div>
    </section>

    <section class="sec g-off reveal">
      <div class="wrap">
        <div class="measure" style="margin-bottom:30px">
          <p class="eyebrow">Curriculum</p>
          <h2>What is covered.</h2>
        </div>
        <div class="grid-5">
          {modules.map((m) => (
            <div class="capsule">
              <div class="capsule-head" style="font-size:13px">{m.h}</div>
              <div class="capsule-body" style="padding:16px 16px 20px"><p class="small" style="font-size:15px;margin:0">{m.b}</p></div>
            </div>
          ))}
        </div>
        <Illus label="Teaching diagram: the DMAIC frame, blank template beside a worked example" h="260px" style="margin-top:30px" />
      </div>
    </section>

    <section class="sec g-white reveal">
      <div class="wrap">
        <div class="measure-wide" style="margin-bottom:30px">
          <p class="eyebrow">Assessment</p>
          <h2>How you are assessed.</h2>
          <p>Four gates. Assessment is project evidence from real work, never a quiz. A participant who does not clear a gate does not hold the credential.</p>
        </div>
        <div class="flow">
          <svg class="flow-arrow" viewBox="0 0 1000 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M0,28 L928,28 L928,0 L1000,50 L928,100 L928,72 L0,72 Z" fill="#C2D4E7"></path>
          </svg>
          <div class="flow-row">
            <div class="capsule"><div class="capsule-head" style="font-size:13px">Training</div><div class="capsule-body" style="padding:16px 16px 20px"><p class="small" style="font-size:15px;margin:0">Attend and take part in the full programme.</p></div></div>
            <div class="flow-tri" aria-hidden="true"><svg width="15" height="20" viewBox="0 0 15 20" xmlns="http://www.w3.org/2000/svg"><path d="M0 0 L15 10 L0 20 Z" fill="#35A8DC"></path></svg></div>
            <div class="capsule"><div class="capsule-head" style="font-size:13px">Knowledge test</div><div class="capsule-body" style="padding:16px 16px 20px"><p class="small" style="font-size:15px;margin:0">A test of the method, not a memory test on jargon.</p></div></div>
            <div class="flow-tri" aria-hidden="true"><svg width="15" height="20" viewBox="0 0 15 20" xmlns="http://www.w3.org/2000/svg"><path d="M0 0 L15 10 L0 20 Z" fill="#35A8DC"></path></svg></div>
            <div class="capsule"><div class="capsule-head" style="font-size:13px">Application</div><div class="capsule-body" style="padding:16px 16px 20px"><p class="small" style="font-size:15px;margin:0">A real project from your own workplace, documented.</p></div></div>
            <div class="flow-tri" aria-hidden="true"><svg width="15" height="20" viewBox="0 0 15 20" xmlns="http://www.w3.org/2000/svg"><path d="M0 0 L15 10 L0 20 Z" fill="#35A8DC"></path></svg></div>
            <div class="capsule"><div class="capsule-head" style="font-size:13px">Coaching</div><div class="capsule-body" style="padding:16px 16px 20px"><p class="small" style="font-size:15px;margin:0">Reviews with an assessor through the project, not only at the end.</p></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec g-tint reveal">
      <div class="wrap split">
        <div>
          <p class="eyebrow">Your credential</p>
          <h2>We train. A separate body certifies.</h2>
          <p>AUSQ assesses your project evidence and issues the credential. We deliver the training and the coaching, and we do not decide whether you pass. That separation is what makes the certificate worth showing an employer.</p>
          <p style="margin-top:16px"><a class="chev" href="/certifications/">How certification works <span class="c" aria-hidden="true">&rsaquo;</span></a></p>
        </div>
        <Illus label="Diagram: trainer and certifier as two separate parties" h="260px" />
      </div>
    </section>

    <section class="sec g-white reveal">
      <div class="wrap grid g2">
        <div class="card">
          <h3>Who it is for</h3>
          <p class="small">Team leaders, analysts, engineers and managers who are expected to fix a process and show the result. No statistics background assumed.</p>
        </div>
        <div class="card">
          <h3>Prerequisites</h3>
          <p class="small">None for the training. To be certified you need a live problem in your own workplace and a sponsor who will release the time to work on it.</p>
        </div>
      </div>
    </section>

    <section class="sec g-off reveal">
      <div class="wrap">
        <div class="measure" style="margin-bottom:24px">
          <p class="eyebrow">Dates and fees</p>
          <h2>Public course dates.</h2>
        </div>
        <div class="table-scroll">
          <table class="data">
            <thead><tr><th>Starts</th><th>Format</th><th>Location</th><th>Fee, per participant, incl GST</th><th>Places</th></tr></thead>
            <tbody>
              <tr><td><span class="todo">DATE</span></td><td>Public</td><td>Melbourne</td><td><span class="todo">PRICE</span></td><td><span class="todo">N</span></td></tr>
              <tr><td><span class="todo">DATE</span></td><td>Public, online</td><td>Online</td><td><span class="todo">PRICE</span></td><td><span class="todo">N</span></td></tr>
              <tr><td>By arrangement</td><td>In-house</td><td>Your site</td><td>Quoted per cohort</td><td>From 8</td></tr>
            </tbody>
          </table>
        </div>
        <p class="meta" style="margin-top:14px">Dates and fees are placeholders until confirmed. Nothing here is published pricing yet.</p>
      </div>
    </section>

    <section class="sec-tight g-white reveal">
      <div class="wrap grid-quote">
        <Illus label="Photograph: the person quoted, real, never generated" h="200px" style="font-size:9px" />
        <div>
          <p class="quote">"I came in with a backlog problem I had been describing the wrong way for two years. By the third session we had reframed it, and by the end we had closed it."</p>
          <p class="quote-by">Operations Manager, state health service</p>
        </div>
      </div>
    </section>

    <section class="sec g-dark reveal">
      <div class="wrap split">
        <div>
          <p class="eyebrow">Next step</p>
          <h2>Bring a problem, not a course code.</h2>
          <p>Tell us what you are trying to shift. We will tell you whether Green Belt is the right level, and say so plainly if it is not.</p>
          <p style="margin-top:22px"><a class="btn btn-on-dark" href="/contact/">Get in touch</a></p>
        </div>
        <div class="cta-tool">
          <p class="eyebrow">Not sure of the level</p>
          <h3 style="color:#fff;margin:0">Belt Level Selector</h3>
          <p>Six questions, no email needed to see the result.</p>
          <a class="chev" href="/resources/">Open the selector <span class="c" aria-hidden="true">&rsaquo;</span></a>
        </div>
      </div>
    </section>

  </main>

  <div class="mobile-bar">
    <div class="p">$<span class="todo">PRICE</span></div>
    <a class="btn" href="/contact/">Enrol</a>
  </div>

  <Footer />
  <script is:inline>document.body.classList.add("has-mobile-bar");</script>
</Layout>
