---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Privacy Policy | Lean Methods Institute" description="Lean Methods Institute privacy policy.">
  <Nav />
  <main class="policy-main">
    <article class="policy-inner">
      <div class="eyebrow">POLICY</div>
      <h1>Privacy Policy</h1>
      <p>This page is a placeholder for the Lean Methods Institute privacy policy. Full policy copy will be added before public launch.</p>
      <h2>Personal information</h2>
      <p>LMI will explain what information is collected, why it is collected, how it is used and how enquiries can be made.</p>
      <h2>Contact</h2>
      <p>Privacy contact details will be confirmed before public launch.</p>
    </article>
  </main>
  <Footer />
</Layout>
