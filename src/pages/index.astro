---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import "../styles/home.css";

const icons = {
  diffLiveWork: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="11" stroke="#2C3E50" stroke-width="1.8"/><circle cx="16" cy="16" r="5.6" stroke="#2C3E50" stroke-width="1.8"/><circle cx="16" cy="16" r="2" fill="#A51C30"/></svg>`,
  diffAiAnalysis: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round"><circle cx="14" cy="14" r="9" stroke="#2C3E50" stroke-width="1.8"/><line x1="20.6" y1="20.6" x2="27" y2="27" stroke="#2C3E50" stroke-width="1.9"/><path d="M14 8.6 L15.5 12.5 L19.4 14 L15.5 15.5 L14 19.4 L12.5 15.5 L8.6 14 L12.5 12.5 Z" fill="#A51C30"/></svg>`,
  diffEvidence: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6 V26 H26" stroke="#2C3E50" stroke-width="1.8"/><polyline points="10,21 15,16 19,18.5 23.5,10.5" stroke="#2C3E50" stroke-width="1.8"/><circle cx="23.5" cy="10.5" r="2.1" fill="#A51C30"/></svg>`,
  methodSixSigma: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linejoin="round"><rect x="6" y="16" width="4.6" height="10" rx="1.2" stroke="#2C3E50" stroke-width="1.8"/><rect x="13.7" y="11" width="4.6" height="15" rx="1.2" stroke="#2C3E50" stroke-width="1.8"/><rect x="21.4" y="6" width="4.6" height="20" rx="1.2" fill="#A51C30"/></svg>`,
  methodServiceDesign: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round"><path d="M22.5 9.5 A9 9 0 1 0 25 16" stroke="#2C3E50" stroke-width="1.8"/><polyline points="18.5,9 22.8,9.3 23,5" stroke="#2C3E50" stroke-width="1.8"/><circle cx="9" cy="20" r="2.1" fill="#A51C30"/></svg>`,
  methodBusinessAnalysis: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="6" width="16" height="21" rx="2.2" stroke="#2C3E50" stroke-width="1.8"/><rect x="12" y="4" width="8" height="4.2" rx="1.3" stroke="#2C3E50" stroke-width="1.8"/><line x1="12" y1="14" x2="20" y2="14" stroke="#2C3E50" stroke-width="1.6"/><line x1="12" y1="17.6" x2="18" y2="17.6" stroke="#2C3E50" stroke-width="1.6"/><polyline points="11.8,22 14,24.2 18.4,20" stroke="#A51C30" stroke-width="1.9"/></svg>`,
  offerInHouse: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round"><path d="M6 27 V13 L16 6.5 L26 13 V27" stroke="#2C3E50" stroke-width="1.8"/><line x1="4" y1="27" x2="28" y2="27" stroke="#2C3E50" stroke-width="1.8"/><rect x="13.4" y="19" width="5.2" height="8" fill="#A51C30"/></svg>`,
  sectorCorporate: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="22" height="15" rx="2.5" stroke="#2C3E50" stroke-width="1.8"/><path d="M12 11 V8.6 A2 2 0 0 1 14 6.6 H18 A2 2 0 0 1 20 8.6 V11" stroke="#2C3E50" stroke-width="1.8"/><line x1="5" y1="18" x2="27" y2="18" stroke="#2C3E50" stroke-width="1.5"/><rect x="14" y="16.4" width="4" height="3.2" rx="0.9" fill="#A51C30"/></svg>`,
  sectorGovernment: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round"><path d="M16 5 L27 11 H5 Z" stroke="#2C3E50" stroke-width="1.8"/><line x1="9" y1="14" x2="9" y2="23" stroke="#2C3E50" stroke-width="1.8"/><line x1="16" y1="14" x2="16" y2="23" stroke="#2C3E50" stroke-width="1.8"/><line x1="23" y1="14" x2="23" y2="23" stroke="#2C3E50" stroke-width="1.8"/><line x1="5.5" y1="26" x2="26.5" y2="26" stroke="#A51C30" stroke-width="2.1"/></svg>`,
  sectorFinancial: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="10" stroke="#2C3E50" stroke-width="1.8"/><polyline points="11,18.5 16,12 21,18.5" stroke="#A51C30" stroke-width="2"/><line x1="16" y1="12" x2="16" y2="21.5" stroke="#A51C30" stroke-width="2"/></svg>`,
  sectorHealthEducation: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10 C13 8 8.5 8 6 9 V25 C8.5 24 13 24 16 26 C19 24 23.5 24 26 25 V9 C23.5 8 19 8 16 10 Z" stroke="#2C3E50" stroke-width="1.8"/><line x1="16" y1="10" x2="16" y2="26" stroke="#2C3E50" stroke-width="1.4"/><line x1="20.6" y1="12.6" x2="20.6" y2="18" stroke="#A51C30" stroke-width="1.9"/><line x1="17.9" y1="15.3" x2="23.3" y2="15.3" stroke="#A51C30" stroke-width="1.9"/></svg>`
};
---

<Layout
  title="Lean Methods Institute | Lean and AI capability training"
  description="Lean Methods Institute builds lean, AI-capable teams. Lean Six Sigma, Lean Service Design and Lean Business Analysis training with AI built in."
>
  <Nav />
  <main>
    <section class="hero" id="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="eyebrow">LEAN X AI TRAINING</div>
          <h1>We build lean, AI-capable teams.</h1>
          <p class="hero-subhead">Lean Six Sigma, Lean Service Design and Lean Business Analysis training for organisations that need improvement capability to show up in live work, not only in course notes.</p>
          <div class="hero-actions">
            <a href="/courses/" class="btn-primary">Explore courses</a>
            <a href="/contact/" class="btn-text"><span class="link-label">Get in touch</span> <span class="ar">&rsaquo;</span></a>
          </div>
          <div class="hero-video-slot" aria-label="Explainer video placeholder">
            <span class="video-play" aria-hidden="true"></span>
            <div>
              <strong>Explainer video slot</strong>
              <p>Short method overview reserved for the first Lean Methods Institute course video.</p>
            </div>
          </div>
        </div>

        <div class="hero-panel" aria-label="Captioned training image placeholder">
          <figure class="photo-slot hero-photo">
            <span>Captioned image slot</span>
            <figcaption>Replace with approved Lean Methods Institute classroom, facilitator or art-directed training imagery. The belt pathway is introduced later, after visitors choose that route.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section grey difference-section" id="our-difference">
      <div class="section-inner split">
        <div class="section-head sticky-head">
          <div class="eyebrow">OUR DIFFERENCE</div>
          <h2 class="section-title">Methods taught through real work, with AI built into the way people improve.</h2>
        </div>
        <div class="difference-stack">
          <article class="difference-card">
            <span class="line-icon supplied-icon" aria-hidden="true" set:html={icons.diffLiveWork}></span>
            <h3>Skills that hold up in live work</h3>
            <p>We teach the method against real operational constraints and the messy reality of service work, not tidy classroom cases.</p>
          </article>
          <article class="difference-card">
            <span class="line-icon supplied-icon" aria-hidden="true" set:html={icons.diffAiAnalysis}></span>
            <h3>Faster analysis without losing rigour</h3>
            <p>We build AI into problem framing, data sense-making and communication, so teams move faster without losing rigour.</p>
          </article>
          <article class="difference-card">
            <span class="line-icon supplied-icon" aria-hidden="true" set:html={icons.diffEvidence}></span>
            <h3>Decisions your team can defend</h3>
            <p>We tie every activity back to the action that produced the result, so your team can defend decisions and repeat the improvement.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section white offers-section" id="offers">
      <div class="section-inner">
        <div class="section-head">
          <div class="eyebrow">FOUR OFFERS</div>
          <h2 class="section-title">Choose the training model that matches the capability you need to build.</h2>
          <p class="section-intro">Each offer is outcome-led, practical and built to connect coursework with live organisational work.</p>
        </div>
        <div class="offer-grid">
          <article class="offer-card">
            <span class="offer-icon supplied-icon" aria-hidden="true" set:html={icons.methodSixSigma}></span>
            <span class="offer-kicker">Core pathway</span>
            <h3>Lean Six Sigma belts</h3>
            <p>Yellow, Green and Black Belt training for teams that need a common improvement method and recognised credentials.</p>
            <a href="/courses/lean-six-sigma/" class="btn-text"><span class="link-label">View pathway</span> <span class="ar">&rsaquo;</span></a>
          </article>
          <article class="offer-card">
            <span class="offer-icon supplied-icon" aria-hidden="true" set:html={icons.methodServiceDesign}></span>
            <span class="offer-kicker">Service teams</span>
            <h3>Lean Service Design</h3>
            <p>Improve service journeys, handoffs and pain points with customer evidence and operational design discipline.</p>
            <a href="/courses/lean-service-design/" class="btn-text"><span class="link-label">View course</span> <span class="ar">&rsaquo;</span></a>
          </article>
          <article class="offer-card">
            <span class="offer-icon supplied-icon" aria-hidden="true" set:html={icons.methodBusinessAnalysis}></span>
            <span class="offer-kicker">Change delivery</span>
            <h3>Lean Business Analysis</h3>
            <p>Frame the right problem, test assumptions early and translate evidence into clear requirements before work scales.</p>
            <a href="/courses/lean-business-analysis/" class="btn-text"><span class="link-label">View course</span> <span class="ar">&rsaquo;</span></a>
          </article>
          <article class="offer-card">
            <span class="offer-icon supplied-icon" aria-hidden="true" set:html={icons.offerInHouse}></span>
            <span class="offer-kicker">Organisation uplift</span>
            <h3>In-house training</h3>
            <p>Contextualise the method around your processes, data, governance and improvement priorities for faster transfer.</p>
            <a href="/contact/" class="btn-text"><span class="link-label">Enquire</span> <span class="ar">&rsaquo;</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="section grey trainline-section" id="belt-pathway">
      <div class="section-inner">
        <div class="section-head">
          <div class="eyebrow">BELT PATHWAY</div>
          <h2 class="section-title">A step-by-step progression from shared language to internal improvement leadership.</h2>
        </div>
        <div class="stair-trainline" aria-label="Lean Six Sigma belt stair progression">
          <svg class="step-path main-step-path" viewBox="0 0 1000 340" preserveAspectRatio="none" aria-hidden="true">
            <path class="step-stroke step-yellow" d="M80 248 H245"/>
            <path class="step-stroke step-green" d="M245 248 V196 H440"/>
            <path class="step-stroke step-black" d="M440 196 V144 H635"/>
            <path class="step-stroke step-master" d="M635 144 V92 H830"/>
          </svg>
          <article class="station yellow" tabindex="0" data-belt-station>
            <p class="station-note">Spot waste, frame problems and support improvement work.</p>
            <svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 3 C53 3 61 11 61 32 C61 53 53 61 32 61 C11 61 3 53 3 32 C3 11 11 3 32 3Z"/><text x="32" y="37">YB</text></svg>
            <h3>Yellow Belt</h3>
          </article>
          <article class="station green is-pinned" tabindex="0" data-belt-station>
            <p class="station-note">Lead scoped projects and apply structured analysis.</p>
            <svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 3 C53 3 61 11 61 32 C61 53 53 61 32 61 C11 61 3 53 3 32 C3 11 11 3 32 3Z"/><text x="32" y="37">GB</text></svg>
            <h3>Green Belt</h3>
          </article>
          <article class="station black" tabindex="0" data-belt-station>
            <p class="station-note">Lead complex work and coach improvement teams.</p>
            <svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 3 C53 3 61 11 61 32 C61 53 53 61 32 61 C11 61 3 53 3 32 C3 11 11 3 32 3Z"/><text x="32" y="37">BB</text></svg>
            <h3>Black Belt</h3>
          </article>
          <article class="station master" tabindex="0" data-belt-station>
            <p class="station-note">Build the system that sustains capability.</p>
            <svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 3 C53 3 61 11 61 32 C61 53 53 61 32 61 C11 61 3 53 3 32 C3 11 11 3 32 3Z"/><text x="32" y="37">MBB</text></svg>
            <h3>Master Black Belt</h3>
          </article>
        </div>
      </div>
    </section>

    <section class="section charcoal highlights-section" id="highlights">
      <div class="section-inner">
        <div class="section-head">
          <div class="eyebrow light">HIGHLIGHTS</div>
          <h2 class="section-title">Training that makes methods usable under pressure.</h2>
        </div>
        <div class="flagship-highlights">
          <article class="flagship-card">
            <span class="flagship-kicker">Active practice</span>
            <h3>Workshops built around doing the work, not watching slides.</h3>
            <p>Learners practise on realistic operating constraints, use AI where it improves the work, and leave with tools they can reuse immediately.</p>
          </article>
          <div class="highlight-rail" aria-label="Training highlights">
            <article class="rail-item">
              <h3>Practice before theory drifts</h3>
              <p>Each block turns the method into an activity: framing the problem, testing the evidence, explaining the decision and planning the next action.</p>
            </article>
            <article class="rail-item">
              <h3>Built for service work</h3>
              <p>Examples use queues, handoffs, approvals, rework, controls and customer friction, so the training fits corporate and public-sector operations.</p>
            </article>
            <article class="rail-item">
              <h3>Reusable work products</h3>
              <p>Learners leave with problem statements, evidence maps, decision summaries and action plans their managers can inspect.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section white org-section">
      <div class="section-inner org-grid">
        <div class="photo-slot org-photo">
          <span>Photography slot</span>
          <p>Replace with genuine Lean Methods Institute facilitator or in-house delivery photography.</p>
        </div>
        <div class="org-copy">
          <div class="eyebrow">CREDENTIALS</div>
          <h2 class="section-title">Lean Methods Institute delivers the training. AUSQ provides independent Lean Six Sigma certification.</h2>
          <p>Lean Methods Institute develops practical improvement capability for corporate, public sector and service teams. The work is grounded in Lean Six Sigma, service design, business analysis and the responsible use of AI in improvement practice.</p>
          <p>AUSQ provides separation for Lean Six Sigma credentials, so learners and employers can distinguish training delivery from independent certification. That separation matters for procurement, governance and employer trust.</p>
          <a href="/courses/lean-six-sigma/" class="btn-text"><span class="link-label">See the credential pathway</span> <span class="ar">&rsaquo;</span></a>
        </div>
      </div>
    </section>

    <section class="section grey sector-section" id="contextualised-training">
      <div class="section-inner">
        <div class="section-head">
          <div class="eyebrow">CONTEXTUALISED TRAINING</div>
          <h2 class="section-title">Programs are adapted to the sector, not delivered as generic improvement theory.</h2>
          <p class="section-intro">The core method stays disciplined. The examples, data, constraints and practice scenarios change to match how the work actually runs.</p>
        </div>
        <div class="sector-selector" data-sector-selector>
          <div class="sector-tabs" role="tablist" aria-label="Training sectors">
            <button class="sector-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="sector-corporate" id="tab-corporate" data-sector-tab="corporate"><span class="sector-tab-icon supplied-icon" aria-hidden="true" set:html={icons.sectorCorporate}></span><span>Corporate services</span></button>
            <button class="sector-tab" type="button" role="tab" aria-selected="false" aria-controls="sector-government" id="tab-government" data-sector-tab="government"><span class="sector-tab-icon supplied-icon" aria-hidden="true" set:html={icons.sectorGovernment}></span><span>Government</span></button>
            <button class="sector-tab" type="button" role="tab" aria-selected="false" aria-controls="sector-financial" id="tab-financial" data-sector-tab="financial"><span class="sector-tab-icon supplied-icon" aria-hidden="true" set:html={icons.sectorFinancial}></span><span>Financial services</span></button>
            <button class="sector-tab" type="button" role="tab" aria-selected="false" aria-controls="sector-health" id="tab-health" data-sector-tab="health"><span class="sector-tab-icon supplied-icon" aria-hidden="true" set:html={icons.sectorHealthEducation}></span><span>Healthcare and education</span></button>
          </div>
          <div class="sector-panels">
            <article class="sector-panel is-active" id="sector-corporate" role="tabpanel" aria-labelledby="tab-corporate" data-sector-panel="corporate">
              <div>
                <span class="sector-label">Corporate services</span>
                <h3>Improve repeatable service work</h3>
                <p>Use customer evidence, queue data and process ownership to reduce friction across shared service operations.</p>
              </div>
              <div class="sector-lists">
                <div>
                  <h4>Common challenges</h4>
                  <ul>
                    <li>Backlogs moving between teams without clear ownership.</li>
                    <li>Inconsistent handoffs across customer and internal service journeys.</li>
                    <li>Improvement work competing with daily delivery pressure.</li>
                  </ul>
                </div>
                <div>
                  <h4>Context we include in training</h4>
                  <ul>
                    <li>Queue data, service-level evidence and demand patterns.</li>
                    <li>Process ownership, escalation paths and operational routines.</li>
                    <li>AI-assisted problem framing for service improvement work.</li>
                  </ul>
                </div>
              </div>
            </article>
            <article class="sector-panel" id="sector-government" role="tabpanel" aria-labelledby="tab-government" data-sector-panel="government" hidden>
              <div>
                <span class="sector-label">Government</span>
                <h3>Make public services easier to run</h3>
                <p>Translate policy, compliance and citizen experience into practical improvement projects.</p>
              </div>
              <div class="sector-lists">
                <div>
                  <h4>Common challenges</h4>
                  <ul>
                    <li>Policy intent losing clarity as work moves into delivery.</li>
                    <li>Citizen experience constrained by compliance and legacy systems.</li>
                    <li>Slow approvals, rework and unclear evidence for change.</li>
                  </ul>
                </div>
                <div>
                  <h4>Context we include in training</h4>
                  <ul>
                    <li>Policy-to-process translation and risk-aware improvement framing.</li>
                    <li>Citizen journey evidence, service standards and governance needs.</li>
                    <li>Practical AI use for synthesis, communication and decision briefs.</li>
                  </ul>
                </div>
              </div>
            </article>
            <article class="sector-panel" id="sector-financial" role="tabpanel" aria-labelledby="tab-financial" data-sector-panel="financial" hidden>
              <div>
                <span class="sector-label">Financial services</span>
                <h3>Control risk while improving flow</h3>
                <p>Connect improvement methods to regulated processes, operational controls and measurable service outcomes.</p>
              </div>
              <div class="sector-lists">
                <div>
                  <h4>Common challenges</h4>
                  <ul>
                    <li>Customer delays caused by control steps and manual rework.</li>
                    <li>Process improvement blocked by risk, compliance and audit needs.</li>
                    <li>Teams measuring activity instead of customer and control outcomes.</li>
                  </ul>
                </div>
                <div>
                  <h4>Context we include in training</h4>
                  <ul>
                    <li>Control mapping, defect evidence and regulated-process examples.</li>
                    <li>Risk-aware root cause analysis and measurable operating controls.</li>
                    <li>AI-supported analysis with human review and governance boundaries.</li>
                  </ul>
                </div>
              </div>
            </article>
            <article class="sector-panel" id="sector-health" role="tabpanel" aria-labelledby="tab-health" data-sector-panel="health" hidden>
              <div>
                <span class="sector-label">Healthcare and education</span>
                <h3>Protect care and learning time</h3>
                <p>Apply Lean tools to handoffs, scheduling, administration and frontline problem solving.</p>
              </div>
              <div class="sector-lists">
                <div>
                  <h4>Common challenges</h4>
                  <ul>
                    <li>Frontline time lost to duplicated administration and rework.</li>
                    <li>Scheduling, referrals and handoffs creating avoidable waiting.</li>
                    <li>Improvement efforts losing momentum after workshops finish.</li>
                  </ul>
                </div>
                <div>
                  <h4>Context we include in training</h4>
                  <ul>
                    <li>Flow, handoff and demand examples from care and learning settings.</li>
                    <li>Practical routines for frontline problem solving and escalation.</li>
                    <li>AI use cases for synthesis, planning and communication support.</li>
                  </ul>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section white methods-section" id="methods-we-teach">
      <div class="section-inner methods-grid">
        <div>
          <div class="eyebrow">METHODS WE TEACH</div>
          <h2 class="section-title">Three practical methods for improving service work.</h2>
          <p class="section-intro">This overview keeps the home page concise. The detail belongs on the dedicated method pages.</p>
        </div>
        <div class="method-card-grid">
          <article class="method-card">
            <span class="method-icon supplied-icon" aria-hidden="true" set:html={icons.methodSixSigma}></span>
            <h3>Lean Six Sigma</h3>
            <p>Structured problem solving through DMAIC, variation reduction, root cause analysis and measurable improvement.</p>
            <a href="/methods/lean-six-sigma/" class="btn-text"><span class="link-label">View method</span> <span class="ar">&rsaquo;</span></a>
          </article>
          <article class="method-card">
            <span class="method-icon supplied-icon" aria-hidden="true" set:html={icons.methodServiceDesign}></span>
            <h3>Lean Service Design</h3>
            <p>Service journeys, handoffs and customer evidence translated into practical operational improvements.</p>
            <a href="/methods/lean-service-design/" class="btn-text"><span class="link-label">View method</span> <span class="ar">&rsaquo;</span></a>
          </article>
          <article class="method-card">
            <span class="method-icon supplied-icon" aria-hidden="true" set:html={icons.methodBusinessAnalysis}></span>
            <h3>Lean Business Analysis</h3>
            <p>Problem framing, evidence-led requirements and early assumption testing before delivery work scales.</p>
            <a href="/methods/lean-business-analysis/" class="btn-text"><span class="link-label">View method</span> <span class="ar">&rsaquo;</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="proof-strip" id="proof-logo-wall">
      <div class="proof-inner">
        <div>
          <div class="eyebrow">TRACK RECORD</div>
          <h2>The organisations whose teams we've trained.</h2>
          <p>We build improvement capability inside complex, regulated operations. These are the teams our graduates take the method back into.</p>
        </div>
        <div class="client-logo-grid" aria-label="Monochrome anonymised organisation marks">
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
        </div>
      </div>
