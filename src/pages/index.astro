---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import "../styles/home.css";
---

<Layout
  title="Lean Methods Institute | Lean and AI capability training"
  description="Lean Methods Institute builds lean, AI-capable teams. Lean Six Sigma, Lean Service Design and Lean Business Analysis training with AI built in."
>
  <Nav />
  <main>
    <section class="hero" id="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="eyebrow">LEAN X AI TRAINING</div>
          <h1>We build lean, AI-capable teams.</h1>
          <p class="hero-subhead">Lean Six Sigma, Lean Service Design and Lean Business Analysis training for organisations that need improvement capability to show up in live work, not only in course notes.</p>
          <div class="hero-actions">
            <a href="/courses/" class="btn-primary">Explore courses</a>
            <a href="/contact/" class="btn-text"><span class="link-label">Get in touch</span> <span class="ar">&rsaquo;</span></a>
          </div>
          <div class="hero-video-slot" aria-label="Explainer video placeholder">
            <span class="video-play" aria-hidden="true"></span>
            <div>
              <strong>Explainer video slot</strong>
              <p>Short method overview reserved for the first LMI course video.</p>
            </div>
          </div>
        </div>

        <div class="hero-panel" aria-label="Captioned training image placeholder">
          <figure class="photo-slot hero-photo">
            <span>Captioned image slot</span>
            <figcaption>Replace with approved LMI classroom, facilitator or art-directed training imagery. The belt pathway is introduced later, after visitors choose that route.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section grey difference-section" id="our-difference">
      <div class="section-inner split">
        <div class="section-head sticky-head">
          <div class="eyebrow">OUR DIFFERENCE</div>
          <h2 class="section-title">Methods taught through real work, with AI built into the way people improve.</h2>
        </div>
        <div class="difference-stack">
          <article class="difference-card">
            <span class="line-icon practice-icon" aria-hidden="true"></span>
            <h3>Skills that hold up in live work</h3>
            <p>Facilitators connect the method to operational constraints, stakeholder pressure and the messy reality of service work.</p>
          </article>
          <article class="difference-card featured">
            <span class="line-icon ai-icon" aria-hidden="true"></span>
            <h3>Faster analysis without losing rigour</h3>
            <p>Learners use AI for problem framing, data sense-making, experiment design and communication without weakening the discipline.</p>
          </article>
          <article class="difference-card">
            <span class="line-icon evidence-icon" aria-hidden="true"></span>
            <h3>Decisions your team can defend</h3>
            <p>Every activity ties back to the action that produced the result, so teams can defend decisions and repeat the improvement.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section white offers-section" id="offers">
      <div class="section-inner">
        <div class="section-head">
          <div class="eyebrow">FOUR OFFERS</div>
          <h2 class="section-title">Choose the training model that matches the capability you need to build.</h2>
          <p class="section-intro">Each offer is outcome-led, practical and built to connect coursework with live organisational work.</p>
        </div>
        <div class="offer-grid">
          <article class="offer-card">
            <span class="offer-icon belt-offer-icon" aria-hidden="true"></span>
            <span class="offer-kicker">Core pathway</span>
            <h3>Lean Six Sigma belts</h3>
            <p>Yellow, Green and Black Belt training for teams that need a common improvement method and recognised credentials.</p>
            <a href="/courses/lean-six-sigma/" class="btn-text"><span class="link-label">View pathway</span> <span class="ar">&rsaquo;</span></a>
          </article>
          <article class="offer-card">
            <span class="offer-icon service-offer-icon" aria-hidden="true"></span>
            <span class="offer-kicker">Service teams</span>
            <h3>Lean Service Design</h3>
            <p>Improve service journeys, handoffs and pain points with customer evidence and operational design discipline.</p>
            <a href="/courses/lean-service-design/" class="btn-text"><span class="link-label">View course</span> <span class="ar">&rsaquo;</span></a>
          </article>
          <article class="offer-card">
            <span class="offer-icon analysis-offer-icon" aria-hidden="true"></span>
            <span class="offer-kicker">Change delivery</span>
            <h3>Lean Business Analysis</h3>
            <p>Frame the right problem, test assumptions early and translate evidence into clear requirements before work scales.</p>
            <a href="/courses/lean-business-analysis/" class="btn-text"><span class="link-label">View course</span> <span class="ar">&rsaquo;</span></a>
          </article>
          <article class="offer-card">
            <span class="offer-icon inhouse-offer-icon" aria-hidden="true"></span>
            <span class="offer-kicker">Organisation uplift</span>
            <h3>In-house training</h3>
            <p>Contextualise the method around your processes, data, governance and improvement priorities for faster transfer.</p>
            <a href="/contact/" class="btn-text"><span class="link-label">Enquire</span> <span class="ar">&rsaquo;</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="section grey trainline-section" id="belt-pathway">
      <div class="section-inner">
        <div class="section-head">
          <div class="eyebrow">BELT PATHWAY</div>
          <h2 class="section-title">A straight progression from shared language to internal improvement leadership.</h2>
        </div>
        <div class="stair-trainline" aria-label="Lean Six Sigma belt stair progression">
          <svg class="step-path main-step-path" viewBox="0 0 1000 250" aria-hidden="true">
            <path class="step-stroke step-yellow" d="M58 206 H226 V158 H394"/>
            <path class="step-stroke step-green" d="M394 158 H562 V110 H730"/>
            <path class="step-stroke step-black" d="M730 110 H894 V62"/>
            <path class="step-stroke step-master" d="M894 62 H942"/>
          </svg>
          <article class="station yellow">
            <svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 4 C50 4 60 14 60 32 C60 50 50 60 32 60 C14 60 4 50 4 32 C4 14 14 4 32 4Z"/><text x="32" y="37">YB</text></svg>
            <h3>Yellow Belt</h3>
            <p>Spot waste, frame problems and support improvement work.</p>
          </article>
          <article class="station green selected">
            <svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 4 C50 4 60 14 60 32 C60 50 50 60 32 60 C14 60 4 50 4 32 C4 14 14 4 32 4Z"/><text x="32" y="37">GB</text></svg>
            <h3>Green Belt</h3>
            <p>Lead scoped projects and apply structured analysis.</p>
          </article>
          <article class="station black">
            <svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 4 C50 4 60 14 60 32 C60 50 50 60 32 60 C14 60 4 50 4 32 C4 14 14 4 32 4Z"/><text x="32" y="37">BB</text></svg>
            <h3>Black Belt</h3>
            <p>Lead complex work and coach improvement teams.</p>
          </article>
          <article class="station master">
            <svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 4 C50 4 60 14 60 32 C60 50 50 60 32 60 C14 60 4 50 4 32 C4 14 14 4 32 4Z"/><text x="32" y="37">MBB</text></svg>
            <h3>Master Black Belt</h3>
            <p>Build the system that sustains capability.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section charcoal highlights-section" id="highlights">
      <div class="section-inner">
        <div class="section-head">
          <div class="eyebrow light">HIGHLIGHTS</div>
          <h2 class="section-title">Training that makes methods usable under pressure.</h2>
        </div>
        <div class="flagship-highlights">
          <article class="flagship-card">
            <div class="flagship-reveal" aria-hidden="true"></div>
            <span class="flagship-kicker">Active practice</span>
            <h3>Workshops built around doing the work, not watching slides.</h3>
            <p>Learners practise the method, receive coaching and leave with tools they can reuse immediately.</p>
          </article>
          <div class="highlight-rail" aria-label="Training highlights">
            <article class="rail-item">
              <h3>AI supports the method</h3>
              <p>AI accelerates analysis and communication while the improvement method remains the control system.</p>
            </article>
            <article class="rail-item">
              <h3>Credentials with separation</h3>
              <p>Lean Six Sigma credentials use an independent certification pathway, not a self-awarded badge.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section white org-section">
      <div class="section-inner org-grid">
        <div class="photo-slot org-photo">
          <span>Photography slot</span>
          <p>Replace with genuine LMI facilitator or in-house delivery photography.</p>
        </div>
        <div class="org-copy">
          <div class="eyebrow">CREDENTIALS</div>
          <h2 class="section-title">LMI delivers the training. AUSQ provides independent Lean Six Sigma certification.</h2>
          <p>Lean Methods Institute develops practical improvement capability for corporate, public sector and service teams. The work is grounded in Lean Six Sigma, service design, business analysis and the responsible use of AI in improvement practice.</p>
          <p>AUSQ provides separation for Lean Six Sigma credentials, so learners and employers can distinguish training delivery from independent certification. That separation matters for procurement, governance and employer trust.</p>
          <a href="/courses/lean-six-sigma/" class="btn-text"><span class="link-label">See the credential pathway</span> <span class="ar">&rsaquo;</span></a>
        </div>
      </div>
    </section>

    <section class="section grey sector-section" id="contextualised-training">
      <div class="section-inner">
        <div class="section-head">
          <div class="eyebrow">CONTEXTUALISED TRAINING</div>
          <h2 class="section-title">Programs are adapted to the sector, not delivered as generic improvement theory.</h2>
          <p class="section-intro">The core method stays disciplined. The examples, data, constraints and practice scenarios change to match how the work actually runs.</p>
        </div>
        <div class="sector-selector" data-sector-selector>
          <div class="sector-tabs" role="tablist" aria-label="Training sectors">
            <button class="sector-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="sector-corporate" id="tab-corporate" data-sector-tab="corporate"><span class="sector-tab-icon corporate-icon" aria-hidden="true"></span><span>Corporate services</span></button>
            <button class="sector-tab" type="button" role="tab" aria-selected="false" aria-controls="sector-government" id="tab-government" data-sector-tab="government"><span class="sector-tab-icon government-icon" aria-hidden="true"></span><span>Government</span></button>
            <button class="sector-tab" type="button" role="tab" aria-selected="false" aria-controls="sector-financial" id="tab-financial" data-sector-tab="financial"><span class="sector-tab-icon financial-icon" aria-hidden="true"></span><span>Financial services</span></button>
            <button class="sector-tab" type="button" role="tab" aria-selected="false" aria-controls="sector-health" id="tab-health" data-sector-tab="health"><span class="sector-tab-icon health-icon" aria-hidden="true"></span><span>Healthcare and education</span></button>
          </div>
          <div class="sector-panels">
            <article class="sector-panel is-active" id="sector-corporate" role="tabpanel" aria-labelledby="tab-corporate" data-sector-panel="corporate">
              <div>
                <span class="sector-label">Corporate services</span>
                <h3>Improve repeatable service work</h3>
                <p>Use customer evidence, queue data and process ownership to reduce friction across shared service operations.</p>
              </div>
              <div class="sector-lists">
                <div>
                  <h4>Common challenges</h4>
                  <ul>
                    <li>Backlogs moving between teams without clear ownership.</li>
                    <li>Inconsistent handoffs across customer and internal service journeys.</li>
                    <li>Improvement work competing with daily delivery pressure.</li>
                  </ul>
                </div>
                <div>
                  <h4>Context we include in training</h4>
                  <ul>
                    <li>Queue data, service-level evidence and demand patterns.</li>
                    <li>Process ownership, escalation paths and operational routines.</li>
                    <li>AI-assisted problem framing for service improvement work.</li>
                  </ul>
                </div>
              </div>
            </article>
            <article class="sector-panel" id="sector-government" role="tabpanel" aria-labelledby="tab-government" data-sector-panel="government" hidden>
              <div>
                <span class="sector-label">Government</span>
                <h3>Make public services easier to run</h3>
                <p>Translate policy, compliance and citizen experience into practical improvement projects.</p>
              </div>
              <div class="sector-lists">
                <div>
                  <h4>Common challenges</h4>
                  <ul>
                    <li>Policy intent losing clarity as work moves into delivery.</li>
                    <li>Citizen experience constrained by compliance and legacy systems.</li>
                    <li>Slow approvals, rework and unclear evidence for change.</li>
                  </ul>
                </div>
                <div>
                  <h4>Context we include in training</h4>
                  <ul>
                    <li>Policy-to-process translation and risk-aware improvement framing.</li>
                    <li>Citizen journey evidence, service standards and governance needs.</li>
                    <li>Practical AI use for synthesis, communication and decision briefs.</li>
                  </ul>
                </div>
              </div>
            </article>
            <article class="sector-panel" id="sector-financial" role="tabpanel" aria-labelledby="tab-financial" data-sector-panel="financial" hidden>
              <div>
                <span class="sector-label">Financial services</span>
                <h3>Control risk while improving flow</h3>
                <p>Connect improvement methods to regulated processes, operational controls and measurable service outcomes.</p>
              </div>
              <div class="sector-lists">
                <div>
                  <h4>Common challenges</h4>
                  <ul>
                    <li>Customer delays caused by control steps and manual rework.</li>
                    <li>Process improvement blocked by risk, compliance and audit needs.</li>
                    <li>Teams measuring activity instead of customer and control outcomes.</li>
                  </ul>
                </div>
                <div>
                  <h4>Context we include in training</h4>
                  <ul>
                    <li>Control mapping, defect evidence and regulated-process examples.</li>
                    <li>Risk-aware root cause analysis and measurable operating controls.</li>
                    <li>AI-supported analysis with human review and governance boundaries.</li>
                  </ul>
                </div>
              </div>
            </article>
            <article class="sector-panel" id="sector-health" role="tabpanel" aria-labelledby="tab-health" data-sector-panel="health" hidden>
              <div>
                <span class="sector-label">Healthcare and education</span>
                <h3>Protect care and learning time</h3>
                <p>Apply Lean tools to handoffs, scheduling, administration and frontline problem solving.</p>
              </div>
              <div class="sector-lists">
                <div>
                  <h4>Common challenges</h4>
                  <ul>
                    <li>Frontline time lost to duplicated administration and rework.</li>
                    <li>Scheduling, referrals and handoffs creating avoidable waiting.</li>
                    <li>Improvement efforts losing momentum after workshops finish.</li>
                  </ul>
                </div>
                <div>
                  <h4>Context we include in training</h4>
                  <ul>
                    <li>Flow, handoff and demand examples from care and learning settings.</li>
                    <li>Practical routines for frontline problem solving and escalation.</li>
                    <li>AI use cases for synthesis, planning and communication support.</li>
                  </ul>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section white methods-section">
      <div class="section-inner methods-grid">
        <div>
          <div class="eyebrow">METHOD VIDEOS</div>
          <h2 class="section-title">Short explainers will teach the method before learners enrol.</h2>
          <p class="section-intro">Reserved slots are in place for concise videos on belt selection, DMAIC, problem framing and how AI supports improvement work.</p>
        </div>
        <div class="video-grid">
          <div class="video-card">
            <span class="video-play" aria-hidden="true"></span>
            <h3>Choose your belt level</h3>
            <p>Explainer slot, 3 to 4 minutes.</p>
          </div>
          <div class="video-card">
            <span class="video-play" aria-hidden="true"></span>
            <h3>Use AI inside DMAIC</h3>
            <p>Explainer slot, 4 to 5 minutes.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="proof-strip" id="proof-logo-wall">
      <div class="proof-inner">
        <div>
          <div class="eyebrow">WHERE OUR GRADUATES WORK</div>
          <h2>Improvement capability for teams working in complex service environments.</h2>
        </div>
        <div class="proof-grid" aria-label="Anonymised graduate workplace logo wall">
          <span><i></i><b>Public service group</b></span>
          <span><i></i><b>Banking operations</b></span>
          <span><i></i><b>Insurance services</b></span>
          <span><i></i><b>Health network</b></span>
          <span><i></i><b>Education provider</b></span>
          <span><i></i><b>Corporate services</b></span>
          <span><i></i><b>Shared service hub</b></span>
          <span><i></i><b>Customer operations</b></span>
          <span><i></i><b>Claims team</b></span>
          <span><i></i><b>Compliance function</b></span>
          <span><i></i><b>Service design group</b></span>
          <span><i></i><b>Improvement office</b></span>
        </div>
        <div class="client-wall" aria-label="Anonymised organisations trained logo wall">
          <div class="client-wall-head">
            <div class="eyebrow">CLIENTS</div>
            <h3>Organisations we've trained</h3>
          </div>
          <div class="client-logo-grid">
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
            <span><i></i></span>
          </div>
        </div>
      </div>
    </section>

    <section class="section white bottom-pathway" id="next-step-pathway">
      <div class="section-inner">
        <div class="bottom-panel">
          <div>
            <div class="eyebrow">NEXT STEP</div>
            <h2 class="section-title">Start with the belt level that matches the work you need people to lead.</h2>
            <p class="section-intro">The sequence is simple: orient the team, build project leadership, then develop the internal capability to coach and govern improvement.</p>
          </div>
          <div class="compact-trainline" aria-label="Bottom belt stair progression">
            <svg class="step-path compact-step-path" viewBox="0 0 520 190" aria-hidden="true">
              <path class="step-stroke step-yellow" d="M28 154 H130 V118 H232"/>
              <path class="step-stroke step-green" d="M232 118 H334 V82 H436"/>
              <path class="step-stroke step-black" d="M436 82 H492 V46"/>
              <path class="step-stroke step-master" d="M492 46 H514"/>
            </svg>
            <span class="compact-station yellow"><svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 4 C50 4 60 14 60 32 C60 50 50 60 32 60 C14 60 4 50 4 32 C4 14 14 4 32 4Z"/><text x="32" y="37">YB</text></svg></span>
            <span class="compact-station green selected"><svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 4 C50 4 60 14 60 32 C60 50 50 60 32 60 C14 60 4 50 4 32 C4 14 14 4 32 4Z"/><text x="32" y="37">GB</text></svg></span>
            <span class="compact-station black"><svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 4 C50 4 60 14 60 32 C60 50 50 60 32 60 C14 60 4 50 4 32 C4 14 14 4 32 4Z"/><text x="32" y="37">BB</text></svg></span>
            <span class="compact-station master"><svg class="belt-badge" viewBox="0 0 64 64" aria-hidden="true"><path class="badge-shape" d="M32 4 C50 4 60 14 60 32 C60 50 50 60 32 60 C14 60 4 50 4 32 C4 14 14 4 32 4Z"/><text x="32" y="37">MBB</text></svg></span>
          </div>
        </div>
      </div>
    </section>

    <section class="equibt-handover" id="equibt-handover" aria-labelledby="equibt-handover-title">
      <div class="handover-inner">
        <div class="handover-copy">
          <div class="eyebrow">PART OF EQUIBT GROUP</div>
          <h2 id="equibt-handover-title">The advisory firm behind the training.</h2>
          <p>Lean Methods Institute is the specialist training division of EQUIBT Group. The same Lean and AI methods EQUIBT runs inside advisory engagements, taught to your team through structured courses, so the capability stays in-house after the project ends.</p>
          <svg class="equibt-wordmark" viewBox="0 0 1900.02 441.3" role="img" aria-label="EQUIBT">
            <g fill="#2C3E50">
              <path d="M45.48,308.58v-172.32h186.84v33.08H87.37v35.23h100.68v33.08h-100.68v37.84h151.61v33.08H45.48Z"/>
              <path d="M421.06,310.01c-5.56,1.11-10.99,1.94-16.3,2.5-5.32.55-10.67.83-16.06.83-17.61,0-33.88-2.46-48.79-7.38-14.92-4.91-27.77-11.9-38.56-20.94-9.84-8.09-17.22-17.45-22.13-28.09-4.92-10.63-7.38-22.29-7.38-34.99,0-25.39,10-46.25,29.99-62.6,10.95-9.04,23.88-16.07,38.8-21.06,14.91-5,31.02-7.5,48.32-7.5s33.44,2.51,48.43,7.5c14.99,5,27.88,12.03,38.68,21.08,19.99,16.68,29.99,37.55,29.99,62.64,0,16.36-4.13,30.93-12.38,43.71-8.25,12.78-20.55,23.46-36.89,32.03l23.09,24.16-36.65,10.95-22.14-22.85ZM431.05,271.21c10.63-5.24,18.6-12.02,23.92-20.35,5.31-8.33,7.97-17.97,7.97-28.92,0-8.57-1.75-16.42-5.24-23.56-3.49-7.14-8.45-13.25-14.88-18.33-6.43-5.08-14.2-9.04-23.33-11.9-9.13-2.86-19.32-4.28-30.58-4.28s-21.46,1.43-30.58,4.29c-9.13,2.86-16.9,6.87-23.32,12.04-6.43,5.17-11.39,11.29-14.88,18.36-3.49,7.08-5.24,14.91-5.24,23.49s1.7,16.69,5.12,23.85c3.41,7.15,8.33,13.27,14.76,18.36,6.43,5.09,14.16,9.03,23.21,11.81,9.05,2.78,19.28,4.17,30.7,4.17h3.33l-19.52-20.47,37.37-10.47,21.18,21.9Z"/>
