  <script>
    const selectors = document.querySelectorAll("[data-sector-selector]");
    selectors.forEach((selector) => {
      const tabs = Array.from(selector.querySelectorAll("[data-sector-tab]"));
      const panels = Array.from(selector.querySelectorAll("[data-sector-panel]"));

      const activate = (key) => {
        tabs.forEach((tab) => {
          const isActive = tab.dataset.sectorTab === key;
          tab.classList.toggle("is-active", isActive);
          tab.setAttribute("aria-selected", String(isActive));
        });
        panels.forEach((panel) => {
          const isActive = panel.dataset.sectorPanel === key;
          panel.classList.toggle("is-active", isActive);
          panel.hidden = !isActive;
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => activate(tab.dataset.sectorTab));
      });
    });

    const beltStations = Array.from(document.querySelectorAll("[data-belt-station]"));
    beltStations.forEach((station) => {
      const pin = () => {
        beltStations.forEach((item) => item.classList.toggle("is-pinned", item === station));
      };
      station.addEventListener("click", pin);
      station.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          pin();
        }
      });
    });
  </script>
