---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { RESOURCE_HUBS } from "../../data/site";
import "../../styles/home.css";

export function getStaticPaths() {
  return RESOURCE_HUBS.map((hub) => ({ params: { hub: hub.slug }, props: { hub } }));
}
const { hub } = Astro.props;
const others = RESOURCE_HUBS.filter((h) => h.slug !== hub.slug);
---
<Layout title={`${hub.name} | Resources | Lean Methods Institute`} description={hub.lede}>
  <Nav />
  <main id="main">

    <section class="page-head">
      <div class="wrap">
        <p class="eyebrow"><a href="/resources/" style="color:inherit">Resources</a> &middot; {hub.name}</p>
        <h1>{hub.h1}</h1>
        <p class="lede measure-wide">{hub.lede}</p>
        <p style="margin-top:16px"><span class="pill">{hub.status}</span></p>
      </div>
    </section>

    <section class="sec g-off reveal">
      <div class="wrap">
        <div class="card card-featured" style="margin-bottom:26px">
          <h3>What is here, and what is not</h3>
          <p class="small" style="margin:0">This shelf is {hub.status === "Planned" ? "planned and nothing on it is written yet" : "being built"}. Everything below is listed so you can see what is coming and tell us if the order is wrong. {hub.gating}</p>
        </div>
        <div class="grid g2">
          {hub.items.map((it) => (
            <div class="card">
              <p class="meta">{hub.kind} &middot; {it.meta}</p>
              <h3 style="margin-top:10px">{it.h}</h3>
              <p class="small" style="margin:0">{it.b}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec g-white reveal">
      <div class="wrap">
        <div class="measure-wide" style="margin-bottom:26px">
          <p class="eyebrow">Elsewhere in the resource centre</p>
          <h2>Five other shelves.</h2>
        </div>
        <div class="grid g3">
          {others.map((o) => (
            <a class="card card-link" href={`/resources/${o.slug}/`}>
              <h3>{o.name}</h3>
              <span class="small" style="display:block;margin-top:8px">{o.lede}</span>
              <span class="chev" style="margin-top:12px;display:inline-flex">Open <span class="c" aria-hidden="true">&rsaquo;</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="sec g-dark reveal">
      <div class="wrap grid-cta">
        <div>
          <p class="eyebrow">The destination</p>
          <h2>The tools are free. The credential is the paid part.</h2>
          <p>Use everything here without ever enrolling. When you want the method taught properly and assessed on your own work, the courses are there.</p>
          <p style="margin-top:22px"><a class="btn btn-on-dark" href="/courses/">Browse courses</a></p>
        </div>
        <div class="cta-tool">
          <p class="eyebrow">Start here</p>
          <h3 style="color:#fff;margin:0">Belt Level Selector</h3>
          <p>Six questions, and a straight answer on which level fits.</p>
          <a class="chev" href="/resources/tools/">Open the selector <span class="c" aria-hidden="true">&rsaquo;</span></a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
