---
// EQT-417. Internal decision page. Not linked from the nav, noindex.
// Same real page content set three ways so the secondary font can be judged
// where it actually has to work: running prose, a data table, a card body and
// a small uppercase label.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/home.css";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/500.css";
import "@fontsource/source-serif-4/400-italic.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/500.css";
import "@fontsource/source-sans-3/600.css";

const options = [
  {
    id: "asis",
    tag: "As-is",
    name: "Montserrat + Lora",
    stack: '"Lora",Georgia,serif',
    weight: 500,
    note: "What is live. Lora is a contemporary text serif with brushed terminals and fairly high stroke contrast. It reads well at 19px in a wide measure and starts to thin out at 16px in tables and card bodies, which is where most of this site's secondary text lives. EQUIBT runs the same pairing.",
  },
  {
    id: "serif",
    tag: "Serif option",
    name: "Montserrat + Source Serif 4",
    stack: '"Source Serif 4",Georgia,serif',
    weight: 400,
    note: "Already in the brand folder. Drawn for screen, larger x-height, lower stroke contrast and flatter serifs, so it holds its colour at 16px where Lora goes light. Quieter than Lora, which lets Montserrat carry the personality.",
  },
  {
    id: "sans",
    tag: "Sans option",
    name: "Montserrat + Source Sans 3",
    stack: '"Source Sans 3",system-ui,sans-serif',
    weight: 400,
    note: "Same design family and metrics as Source Serif 4, so the two can be swapped later without a single line of layout moving. Humanist rather than geometric, so it sits under Montserrat instead of competing with it. Makes the site all-sans, which suits pages that are mostly course data, prices and tables.",
  },
];

const rows = [
  { c: "Yellow Belt", d: "1 day", f: "A$895" },
  { c: "Lean Practitioner", d: "3 days", f: "A$2,650" },
  { c: "Green Belt", d: "5 days", f: "A$4,345" },
  { c: "Black Belt", d: "8 days", f: "A$6,250" },
];
---
<Layout title="Type comparison | Lean Methods Institute" description="Internal type comparison for EQT-417.">
  <Fragment slot="head"><meta name="robots" content="noindex,nofollow" /></Fragment>
  <Nav />
  <main id="main">

    <section class="page-head">
      <div class="wrap">
        <p class="eyebrow">EQT-417 · internal</p>
        <h1>Secondary font, three ways.</h1>
        <p class="lede measure-wide">The heading font does not change. Montserrat carries every heading, label and button in all three. What changes is the body serif, the one doing the work in prose, tables and card copy.</p>
        <p class="small measure">Judge it at the sizes that matter, not the headline. The 16px table and the card body below are where the current font is going soft.</p>
      </div>
    </section>

    {options.map((o) => (
      <section class={`sec ${o.id === "serif" ? "g-off" : o.id === "sans" ? "g-tint" : "g-white"} type-spec`} style={`--font-body:${o.stack};`}>
        <div class="wrap">
          <div class="measure-wide" style="margin-bottom:28px">
            <p class="eyebrow">{o.tag}</p>
            <h2 style={`font-family:${o.stack};font-weight:${o.weight}`}>{o.name}</h2>
            <p class="small" style="color:var(--charcoal-grey)">{o.note}</p>
          </div>

          <div class="split" style="align-items:start">
            <div>
              <h3>Take the waste out and make the work flow.</h3>
              <p>We train Lean Six Sigma, Lean Service Design and Lean Business Analysis for teams across Australia and New Zealand. Every belt teaches where AI carries the work, and where it must not touch it. Most training bolts an AI module onto the end. We build it into each belt, on the tools the participant already uses, with a clear line around the judgement a person has to make and defend.</p>
              <p class="small">Secondary prose at 16px. A real project from your own workplace, documented as evidence. There is no participation certificate, and a gate that is not cleared is not waived.</p>
              <p class="caption">A caption in italic, which is where a text serif shows its manners.</p>
            </div>

            <div class="stack" style="gap:22px">
              <div class="card course-card">
                <div class="course-top">
                  <h4 style="margin:0">Green Belt</h4>
                  <div class="price">A$4,345<small>incl GST, per participant</small></div>
                </div>
                <p class="small" style="margin:10px 0 0">Lead a project end to end and prove the result. Five days, then a workplace project with coaching behind it and independent assessment at the end.</p>
                <div class="pill-row" style="margin-top:12px">
                  <span class="pill">AUSQ certified</span>
                  <span class="pill">5 days</span>
                </div>
              </div>

              <div class="table-scroll">
                <table class="data" style="min-width:0">
                  <thead><tr><th>Course</th><th>Duration</th><th>Fee, incl GST</th></tr></thead>
                  <tbody>
                    {rows.map((r) => (<tr><td>{r.c}</td><td>{r.d}</td><td>{r.f}</td></tr>))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))}

    <section class="sec g-dark">
      <div class="wrap measure-wide">
        <p class="eyebrow">The trade</p>
        <h2>What each choice costs you.</h2>
        <p><strong>Staying on Lora</strong> keeps Lean Methods Institute and EQUIBT running the same body type, which matters more now that the logo square is moving to the EQUIBT navy. The cost is that it stays slightly under-powered at 16px.</p>
        <p><strong>Source Serif 4</strong> fixes the small-size problem and keeps the site a serif site, so the character does not change. The cost is that the two brands diverge on body type in the same month they converge on colour.</p>
        <p><strong>Source Sans 3</strong> is the cleanest read for a site that is mostly course data. The cost is the largest: an all-sans Lean Methods Institute next to a serif EQUIBT reads as two companies, not one group.</p>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style is:global>
  /* Scope the swap to the panel. Headings, labels and buttons stay Montserrat. */
  .type-spec p,
  .type-spec td,
  .type-spec .small,
  .type-spec .caption,
  .type-spec .lede { font-family: var(--font-body); }
</style>
