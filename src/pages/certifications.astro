---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BeltBadge from "../components/BeltBadge.astro";
import "../styles/home.css";

// EQT-417. Each gate states the pass condition first, then the fail condition.
// Showing only the fail state made the page read as though the visitor had
// already failed all four.
const gates = [
  {
    h: "Training",
    b: "Attend and take part in the full programme.",
    pass: "You attend every session and take part in the exercises.",
    fail: "You miss content. It is not waived. You sit that session with the next cohort.",
  },
  {
    h: "Knowledge test",
    b: "A test of the method, not a memory test on jargon.",
    pass: "You reach the standard. A pass is a pass, whichever attempt it comes on.",
    fail: "You are below the standard. You sit it again. After two attempts we coach you before a third.",
  },
  {
    h: "Application",
    b: "A real project from your own workplace, documented as evidence.",
    pass: "Your project shows a measured before and after, and you can defend the method you used.",
    fail: "There is no measured result. The project comes back for the measurement rather than being refused.",
  },
  {
    h: "Coaching",
    b: "Reviews with an assessor through the project, not only at the end.",
    pass: "You attend your reviews and act on what comes out of them.",
    fail: "Reviews are skipped. Assessment stops until they are done.",
  },
];

// Illustrative paths, not case studies. No figures, because we do not publish
// participant results without the client clearing them.
const paths = [
  {
    tag: "Clears all four",
    tone: "pass",
    b: "Attends the full programme. Passes the knowledge test on the first sitting. Runs a changeover project with a measured before and after. Attends every review. Credential issued at the end of the cohort.",
  },
  {
    tag: "One resit, same credential",
    tone: "pass",
    b: "Sits the knowledge test twice and passes on the second attempt. Everything else on time. The credential is identical and the resit does not appear on it.",
  },
  {
    tag: "Project comes back",
    tone: "hold",
    b: "A real improvement, but nothing was measured before the change. The project returns for the baseline and the credential follows a few weeks later. Nothing else is repeated.",
  },
];

const ladderA = [
  { code: "YB",  name: "Yellow Belt",       b: "Contributes to improvement work and runs small local fixes." },
  { code: "GB",  name: "Green Belt",        b: "Leads a project end to end and proves the result." },
  { code: "BB",  name: "Black Belt",        b: "Solves cross-functional problems and coaches Green Belts." },
  { code: "MBB", name: "Master Black Belt", b: "Builds the capability, sets the standard, develops Black Belts." },
] as const;
---
<Layout title="Certifications | Lean Methods Institute" description="We train. A separate body certifies. How Lean Methods Institute credentials are assessed, what each level means, and how an employer verifies one.">
  <Nav />
  <main id="main">

    <section class="page-head">
      <div class="wrap">
        <p class="eyebrow">Certifications</p>
        <h1>We train. A separate body certifies.</h1>
        <p class="lede measure-wide">Most training providers assess their own students and issue their own certificates. We do not. AUSQ assesses the evidence and issues the Lean Six Sigma credential, and it does not deliver our training.</p>
      </div>
    </section>

    <section class="sec g-off reveal">
      <div class="wrap">
        <div class="measure" style="margin-bottom:26px">
          <p class="eyebrow">The separation</p>
          <h2>Who does what, and who decides.</h2>
        </div>
        <div class="sep-diagram">
          <svg class="sep-h" viewBox="0 0 1000 300" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Lean Methods Institute delivers training and coaching. Project evidence passes to AUSQ, an independent body, which assesses it and issues the credential back to the participant.">
            <g filter="url(#ink1)">
              <rect x="10" y="40" width="290" height="150" rx="26" fill="#FFFFFF" stroke="#1F3268" stroke-width="2"/>
              <path d="M330,132 L688,132" fill="none" stroke="#5B87C0" stroke-width="2" stroke-linecap="round"/>
              <path d="M676,122 L690,132 L676,142" fill="none" stroke="#5B87C0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="700" y="40" width="290" height="150" rx="26" fill="#FFFFFF" stroke="#2E6CB5" stroke-width="2"/>
              <path d="M845,196 L845,262 L172,262" fill="none" stroke="#2E6CB5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M184,252 L170,262 L184,272" fill="none" stroke="#2E6CB5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </g>
            <path d="M10,66 A26,26 0 0 1 36,40 L274,40 A26,26 0 0 1 300,66 L300,86 L10,86 Z" fill="#1F3268"/>
            <path d="M700,66 A26,26 0 0 1 726,40 L964,40 A26,26 0 0 1 990,66 L990,86 L700,86 Z" fill="#2E6CB5"/>
            <text x="155" y="70" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="700" font-size="16" letter-spacing="1.4" fill="#FFFFFF">WE TRAIN</text>
            <text x="155" y="122" text-anchor="middle" font-family="Source Serif 4,Georgia,serif" font-size="17" fill="#161616">Teaching, coaching,</text>
            <text x="155" y="148" text-anchor="middle" font-family="Source Serif 4,Georgia,serif" font-size="17" fill="#161616">project supervision</text>
            <text x="155" y="174" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="600" font-size="12" letter-spacing="1" fill="#4A4A4A">NO SAY IN THE OUTCOME</text>
            <text x="509" y="118" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="700" font-size="13" letter-spacing="1.6" fill="#1F3268">PROJECT EVIDENCE</text>
            <text x="845" y="70" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="700" font-size="16" letter-spacing="1.4" fill="#FFFFFF">AUSQ CERTIFIES</text>
            <text x="845" y="122" text-anchor="middle" font-family="Source Serif 4,Georgia,serif" font-size="17" fill="#161616">Independent assessment</text>
            <text x="845" y="148" text-anchor="middle" font-family="Source Serif 4,Georgia,serif" font-size="17" fill="#161616">and the credential</text>
            <text x="845" y="174" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="600" font-size="12" letter-spacing="1" fill="#4A4A4A">DOES NOT DELIVER TRAINING</text>
            <text x="512" y="248" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="700" font-size="13" letter-spacing="1.6" fill="#2E6CB5">CREDENTIAL ISSUED TO THE PARTICIPANT</text>
          </svg>
          <svg class="sep-v" viewBox="0 0 360 460" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Lean Methods Institute delivers training and coaching. Project evidence passes to AUSQ, an independent body, which assesses it and issues the credential back to the participant.">
            <g filter="url(#ink1)">
              <rect x="60" y="8" width="290" height="140" rx="24" fill="#FFFFFF" stroke="#1F3268" stroke-width="2"/>
              <path d="M110,152 L110,222" fill="none" stroke="#5B87C0" stroke-width="2" stroke-linecap="round"/>
              <path d="M100,212 L110,224 L120,212" fill="none" stroke="#5B87C0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="60" y="232" width="290" height="140" rx="24" fill="#FFFFFF" stroke="#2E6CB5" stroke-width="2"/>
              <path d="M320,376 L320,430 L30,430 L30,80 L58,80" fill="none" stroke="#2E6CB5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M48,70 L60,80 L48,90" fill="none" stroke="#2E6CB5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </g>
            <path d="M60,32 A24,24 0 0 1 84,8 L326,8 A24,24 0 0 1 350,32 L350,50 L60,50 Z" fill="#1F3268"/>
            <path d="M60,256 A24,24 0 0 1 84,232 L326,232 A24,24 0 0 1 350,256 L350,274 L60,274 Z" fill="#2E6CB5"/>
            <text x="205" y="36" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="700" font-size="15" letter-spacing="1.3" fill="#FFFFFF">WE TRAIN</text>
            <text x="205" y="86" text-anchor="middle" font-family="Source Serif 4,Georgia,serif" font-size="16" fill="#161616">Teaching, coaching,</text>
            <text x="205" y="108" text-anchor="middle" font-family="Source Serif 4,Georgia,serif" font-size="16" fill="#161616">project supervision</text>
            <text x="205" y="132" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="600" font-size="11" letter-spacing="0.9" fill="#4A4A4A">NO SAY IN THE OUTCOME</text>
            <text x="132" y="194" font-family="Montserrat,Arial,sans-serif" font-weight="700" font-size="13" letter-spacing="1.4" fill="#1F3268">PROJECT EVIDENCE</text>
            <text x="205" y="260" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="700" font-size="15" letter-spacing="1.3" fill="#FFFFFF">AUSQ CERTIFIES</text>
            <text x="205" y="310" text-anchor="middle" font-family="Source Serif 4,Georgia,serif" font-size="16" fill="#161616">Independent assessment</text>
            <text x="205" y="332" text-anchor="middle" font-family="Source Serif 4,Georgia,serif" font-size="16" fill="#161616">and the credential</text>
            <text x="205" y="356" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="600" font-size="11" letter-spacing="0.9" fill="#4A4A4A">DOES NOT DELIVER TRAINING</text>
            <text x="175" y="398" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="700" font-size="13" letter-spacing="1.4" fill="#2E6CB5">CREDENTIAL ISSUED</text>
            <text x="175" y="416" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-weight="700" font-size="13" letter-spacing="1.4" fill="#2E6CB5">TO THE PARTICIPANT</text>
          </svg>
        </div>
      </div>
    </section>

    <section class="sec g-white reveal">
      <div class="wrap">
        <div class="measure-wide" style="margin-bottom:30px">
          <p class="eyebrow">The four gates</p>
          <h2>Clear all four, or you do not hold the credential.</h2>
          <p>There is no participation certificate. Each gate below states what clears it and what does not, so you can see the standard before you enrol.</p>
        </div>
        <div class="grid g4">
          {gates.map((g) => (
            <div class="capsule">
              <div class="capsule-head">{g.h}</div>
              <div class="capsule-body">
                <p class="small" style="margin:0">{g.b}</p>
                <div class="gate-state">
                  <span class="signal-quiet signal-pass">Cleared</span>
                  <p class="gate-note">{g.pass}</p>
                </div>
                <div class="gate-state">
                  <span class="signal-quiet">Not cleared</span>
                  <p class="gate-note">{g.fail}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="measure-wide" style="margin:56px 0 24px">
          <h3>What this looks like in practice.</h3>
          <p class="small">Three paths through the same four gates. Two of them end in a credential on the day, and the third ends in one a few weeks later.</p>
        </div>
        <div class="grid g3">
          {paths.map((p) => (
            <div class="card">
              <span class={p.tone === "pass" ? "signal-quiet signal-pass" : "signal-quiet signal-hold"}>{p.tag}</span>
              <p class="small" style="margin:12px 0 0">{p.b}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec g-off reveal">
      <div class="wrap">
        <div class="measure-wide" style="margin-bottom:30px">
          <p class="eyebrow">The two ladders</p>
          <h2>Improvement capability, and Lean system capability.</h2>
          <p>They are different things and they are certified separately. A Black Belt who has never designed a management system is not a Lean Practitioner, and the reverse is just as true.</p>
        </div>
        <div class="grid g2" style="gap:40px">
          <div>
            <h3 style="margin-bottom:16px">Improvement capability</h3>
            <div class="grid" style="gap:12px">
              {ladderA.map((l) => (
                <div class="card" style="display:flex;gap:16px;align-items:center;padding:16px 18px">
                  <BeltBadge code={l.code} size={44} />
                  <div>
                    <h4 style="margin:0 0 3px">{l.name}</h4>
                    <p class="small" style="margin:0">{l.b}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div>
            <h3 style="margin-bottom:16px">Lean system capability</h3>
            <div class="grid" style="gap:12px">
              <div class="card" style="padding:16px 18px">
                <h4 style="margin:0 0 3px">Lean Foundation</h4>
                <p class="small" style="margin:0">Understands flow, waste and standard work, and can take part in a Lean system.</p>
              </div>
              <div class="card" style="padding:16px 18px">
                <h4 style="margin:0 0 3px">Lean Practitioner</h4>
                <p class="small" style="margin:0">Designs and runs the management system that keeps improvement going after the project ends.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="card card-featured" style="margin-top:28px;padding:18px 22px">
          <h4 style="margin:0 0 3px">Lean Executive Champion</h4>
          <p class="small" style="margin:0">A sponsor role. It sits on neither ladder, because sponsoring the work is not the same as doing it.</p>
        </div>
      </div>
    </section>

    <section class="sec g-white g-wash g-wash-l reveal" id="verify">
      <div class="wrap split">
        <div>
          <p class="eyebrow">For employers</p>
          <h2>Verify a credential in one step.</h2>
          <p>Enter the credential ID and you get one clean result: the holder, the level, the date and whether it is current. No paginated register, no scrolling through eighteen thousand rows.</p>
          <p>Every credential also carries a shareable digital badge with a verifiable link, which the holder can add to a LinkedIn profile.</p>
        </div>
        <div class="card card-tint" style="padding:30px">
          <h3 style="margin-bottom:14px">Check a credential</h3>
          <form class="verify" onsubmit="return false">
            <label class="sr-only" for="credid">Credential ID</label>
            <input id="credid" type="text" placeholder="Credential ID" autocomplete="off" />
            <button class="btn" type="submit">Verify</button>
          </form>
          <p class="meta" style="margin-top:14px">Lookup is handled by the certifying body, not by us.</p>
        </div>
      </div>
    </section>

    <section class="sec g-off reveal">
      <div class="wrap">
        <div class="measure-wide" style="margin-bottom:26px">
          <p class="eyebrow">Plain language</p>
          <h2>What each credential means to an employer.</h2>
        </div>
        <div class="table-scroll">
          <table class="data">
            <thead><tr><th>Credential</th><th>Can be trusted to</th><th>Evidence behind it</th><th>Typical time</th></tr></thead>
            <tbody>
              <tr><td>Yellow Belt</td><td>Contribute to improvement work and run small local fixes.</td><td>Knowledge test plus a supervised contribution.</td><td>2 days</td></tr>
              <tr><td>Green Belt</td><td>Lead a project end to end and defend the result to a manager.</td><td>A completed project with a measured outcome.</td><td>3 to 6 months</td></tr>
              <tr><td>Black Belt</td><td>Solve cross-functional problems and coach Green Belts.</td><td>Two projects, one of them cross-functional.</td><td>6 to 12 months</td></tr>
              <tr><td>Master Black Belt</td><td>Build the capability and set the standard for others.</td><td>Portfolio, coaching record, and assessed teaching.</td><td>12 months or more</td></tr>
              <tr><td>Lean Foundation</td><td>Take part in a Lean system and use standard work.</td><td>Knowledge test.</td><td>1 day</td></tr>
              <tr><td>Lean Practitioner</td><td>Design and run the management system that holds the gains.</td><td>A designed and implemented system, assessed in place.</td><td>6 months</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="sec g-dark reveal">
      <div class="wrap split">
        <div>
          <p class="eyebrow">Questions from procurement</p>
          <h2>Ask us the hard one.</h2>
          <p>If you are assessing training providers and want to know exactly who assesses what, ask. We will put the separation in writing.</p>
          <p style="margin-top:22px"><a class="btn btn-on-dark" href="/contact/">Get in touch</a></p>
        </div>
        <div class="cta-tool">
          <p class="eyebrow">Start the pathway</p>
          <h3 style="color:#fff;margin:0">Belt Level Selector</h3>
          <p>Work out which level matches the decisions your people have to defend.</p>
          <a class="chev" href="/resources/">Open the selector <span class="c" aria-hidden="true">&rsaquo;</span></a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
