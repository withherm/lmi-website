---
import "@fontsource/montserrat/500.css";
import "@fontsource/montserrat/600.css";
import "@fontsource/montserrat/700.css";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/500.css";
import "@fontsource/source-serif-4/500-italic.css";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lean Methods Institute | Lean and AI capability training",
  description =
    "Lean Methods Institute builds lean, AI-capable teams. Lean Six Sigma, Lean Service Design and Lean Business Analysis training with AI built in.",
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1F3268" />
    <link rel="icon" href="/assets/logos/lmi-logo.svg" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <slot />

    <script is:inline>
      // Section reveal: one fade + 8px rise, once, reduced-motion safe.
      (function () {
        var els = document.querySelectorAll(".reveal");
        if (!els.length) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
          els.forEach(function (el) { el.classList.add("in"); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
          });
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.05 });
        els.forEach(function (el) { io.observe(el); });
      })();

      // Nav: ported from equibt-website. Desktop opens on CSS :hover; this
      // handles the hamburger, keyboard focus, the mobile accordion, Esc and
      // outside click. Breakpoint must match base.css (820px).
      (function () {
        var MOBILE = 1024;   // must match the nav breakpoint in base.css
        function isMobile() { return window.innerWidth <= MOBILE; }

        var toggle = document.querySelector(".nav-toggle");
        var navLinks = document.getElementById("nav-links");

        function setMenu(open) {
          document.body.classList.toggle("nav-open", open);
          if (toggle) {
            toggle.setAttribute("aria-expanded", String(open));
            toggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
          }
          if (navLinks) {
            navLinks.classList.toggle("is-open", open);
            // The overlay covers the page, so the page behind it must not be
            // reachable by keyboard while it is open. WCAG 2.4.11. EQT-417.
            navLinks.setAttribute("aria-modal", String(open));
            navLinks.setAttribute("role", open ? "dialog" : "");
          }
          // Everything outside the overlay, including the skip link and the
          // logo, which sit in the header but behind the panel.
          var behind = [
            document.getElementById("main"),
            document.querySelector(".site-footer"),
            document.querySelector("a.sr-only"),
            document.querySelector(".nav-logo")
          ];
          behind.forEach(function (el) {
            if (!el) return;
            if (open) el.setAttribute("inert", "");
            else el.removeAttribute("inert");
          });
          if (!open && toggle) toggle.focus();
        }

        if (toggle) {
          toggle.addEventListener("click", function () {
            setMenu(!document.body.classList.contains("nav-open"));
          });
        }

        // Escape closes the overlay and puts focus back on the hamburger.
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && document.body.classList.contains("nav-open")) {
            setMenu(false);
          }
        });

        var items = document.querySelectorAll("[data-dropdown]");

        function openItem(item) {
          var b = item.querySelector(".nav-chevron-btn");
          if (b) b.setAttribute("aria-expanded", "true");
          item.classList.add("is-open");
        }
        function closeItem(item) {
          var b = item.querySelector(".nav-chevron-btn");
          if (b) b.setAttribute("aria-expanded", "false");
          item.classList.remove("is-open");
        }

        items.forEach(function (item) {
          var btn = item.querySelector(".nav-chevron-btn");

          // Desktop: keyboard focus opens, leaving the item closes.
          var dismissing = false;
          item.addEventListener("focusin", function () {
            if (!isMobile() && !dismissing) openItem(item);
          });
          item.addEventListener("focusout", function (e) {
            if (!isMobile() && !item.contains(e.relatedTarget)) closeItem(item);
          });

          // Mobile: the chevron button is an accordion toggle.
          if (btn) {
            btn.addEventListener("click", function (e) {
              if (isMobile()) {
                e.preventDefault();
                if (item.classList.contains("is-open")) closeItem(item);
                else openItem(item);
              }
            });
          }

          item.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
              dismissing = true;
              closeItem(item);
              if (btn) btn.focus();
              // Release on the next frame, after the focus event has fired.
              setTimeout(function () { dismissing = false; }, 0);
            }
          });
        });

        document.addEventListener("click", function (e) {
          if (isMobile()) return;
          items.forEach(function (item) {
            if (!item.contains(e.target)) closeItem(item);
          });
        });

        // Closing the mobile menu closes every accordion with it.
        if (navLinks && "MutationObserver" in window) {
          var mo = new MutationObserver(function () {
            if (!document.body.classList.contains("nav-open")) {
              items.forEach(closeItem);
            }
          });
          mo.observe(document.body, { attributes: true, attributeFilter: ["class"] });
        }
      })();
    </script>
  </body>
</html>
